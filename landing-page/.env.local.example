# ─────────────────────────────────────────────────────────────
# CryoSeat — Environment Variables (copy to .env.local)
# ─────────────────────────────────────────────────────────────

# Analytics (optional — page works without these)
# Plausible (self-hosted or cloud)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=yourdomain.com

# Google Analytics (GA4)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Email backend (choose one)
# Option A: Formspree (backendless, recommended for quick start)
NEXT_PUBLIC_FORMSPREE_ID=your_formspree_form_id

# Option B: API route (stores to SQLite locally, swap to Supabase in prod)
# Set NEXT_PUBLIC_USE_API_ROUTE=true to use /api/lead instead of Formspree
NEXT_PUBLIC_USE_API_ROUTE=false

# Supabase (used by /api/lead in production when set)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Site URL (used for OG tags and canonical URLs)
NEXT_PUBLIC_SITE_URL=https://cryoseat.com
